{
  "xsappname": "purchase-request",
  "tenant-mode": "dedicated",
  "description": "Security profile for Purchase Request Application",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Administrator"
    },
    {
      "name": "$XSAPPNAME.User",
      "description": "User"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Administrator Role",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ],
      "attribute-references": []
    },
    {
      "name": "User",
      "description": "User Role",
      "scope-references": [
        "$XSAPPNAME.User"
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "PurchaseRequestAdmin",
      "description": "Purchase Request Administrator",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "PurchaseRequestUser",
      "description": "Purchase Request User",
      "role-template-references": [
        "$XSAPPNAME.User"
      ]
    }
  ]
}
