{
  "_version": "1.76.0",
  "sap.app": {
    "id": "demo.purchaserequest",
    "type": "application",
    "i18n": "i18n/i18n_zh_CN.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/purchase-request/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://cart",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.gantt": {},
        "sap.ui.table": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "demo.purchaserequest.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "zh_CN"
          ],
          "fallbackLocale": "en"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "demo.purchaserequest.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "RouteSimpleList",
          "target": "TargetSimpleList"
        },
        {
          "pattern": "list",
          "name": "RouteList",
          "target": "TargetList"
        },
        {
          "pattern": "PurchaseRequest/{objectId}",
          "name": "RouteDetail",
          "target": "TargetDetail"
        }
      ],
      "targets": {
        "TargetSimpleList": {
          "viewId": "SimpleList",
          "viewName": "SimpleList"
        },
        "TargetList": {
          "viewId": "List",
          "viewName": "List"
        },
        "TargetDetail": {
          "viewId": "Detail",
          "viewName": "Detail"
        }
      }
    },
    "rootView": {
      "viewName": "demo.purchaserequest.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    }
  }
}
